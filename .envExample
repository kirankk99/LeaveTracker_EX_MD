# MongoDB connection string.
# For Netlify deployment you MUST use MongoDB Atlas (a free M0 cluster is fine)
# since Netlify's serverless functions cannot reach a database on your laptop.
MONGO_URI="mongodb://<your code>"
SESSION_TTL_SECONDS="604800";
JWT_SECRET='c28d899b<your jwt secret>';
SUPER_ADMIN_EMAIL="super@example.com";
SUPER_ADMIN_NAME="super admin";
SUPER_ADMIN_PASSWORD="TestPassword123!";
